{
    "name"              : "jbzoo/toolbox-dev",
    "type"              : "library",
    "description"       : "Developer toolbox only for JBZoo libs on github+travis",
    "license"           : "MIT",
    "keywords"          : [
        "jbzoo",
        "toolbox",
        "dev",
        "devkit",
        "dev-kit",
        "developer",
        "debug"
    ],

    "authors"           : [
        {
            "name"  : "Denis Smetannikov",
            "email" : "admin@jbzoo.com",
            "role"  : "lead"
        }
    ],

    "minimum-stability" : "dev",
    "prefer-stable"     : true,

    "require"           : {
        "php"                         : "^8.2",

        "jbzoo/phpunit"               : "^7.2",
        "jbzoo/codestyle"             : "^7.1.6",
        "jbzoo/markdown"              : "^7.0",

        "jbzoo/jbdump"                : ">=1.5.6|^7.0",
        "symfony/var-dumper"          : ">=7.3.4",

        "php-coveralls/php-coveralls" : ">=2.8.0",
        "fakerphp/faker"              : ">=1.24.1"
    },

    "autoload"          : {
        "psr-4" : {"JBZoo\\ToolboxDev\\" : "src"},
        "files" : ["src/var-dumper.php"]
    },

    "autoload-dev"      : {
        "psr-4" : {"JBZoo\\PHPUnit\\" : "tests"}
    },

    "config"            : {
        "optimize-autoloader" : true,
        "allow-plugins"       : {"composer/package-versions-deprecated" : true}
    },

    "extra"             : {
        "branch-alias" : {
            "dev-master" : "7.x-dev"
        }
    }
}
